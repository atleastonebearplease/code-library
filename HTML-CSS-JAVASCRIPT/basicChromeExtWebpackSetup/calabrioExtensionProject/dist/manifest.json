{
    "manifest_version": 3,
    "name": "Calabrioadie",
    "version": "0.1",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "./imgs/roadie.png"
    },
    "permissions": [
        "tabs", 
        "activeTab", 
        "scripting",
        "clipboardWrite"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "host_permissions": ["<all_urls>"]
}